<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SimpleModManager</AssemblyName>
    <RootNamespace>SimpleModManager</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Simple Mod Manager</Product>
    <Version>3.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LoweredArms\**\*.cs;Linux\**\*.cs;Community\**\*.cs" />
    <None Remove="Linux\**" />
    <Resource Remove="Assets\i-hate-ghosts.png" />
    <Resource Include="Assets\*.png;Assets\*.gif;Assets\app.ico;Assets\malachi-logo.jpg" Exclude="Assets\i-hate-ghosts.png" />
    <EmbeddedResource Include="Assets\RIPPER.dll" LogicalName="SimpleModManager.Mods.RIPPER.dll" />
    <EmbeddedResource Include="Assets\Leg Arms.dll" LogicalName="SimpleModManager.Mods.GorillaLegs.dll" />
    <EmbeddedResource Include="Assets\MicInputSwitcher.dll" LogicalName="SimpleModManager.Mods.MicInputSwitcher.dll" />
    <EmbeddedResource Include="Assets\xyfer..dll" LogicalName="SimpleModManager.Mods.XyferFree.dll" />
    <EmbeddedResource Include="Assets\ForeverCosmetix.dll" LogicalName="SimpleModManager.Mods.CosmeticX.dll" />
    <EmbeddedResource Include="Assets\WalkSimulator.dll" LogicalName="SimpleModManager.Mods.WalkSimulator.dll" />
  </ItemGroup>
</Project>

